# Telegram (обязательно для отправки заказов)
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789
# Несколько chat_id через запятую: 111,222

# Темы группы (необязательно). Если заданы — заказы падают в тему «В работе»
# с кнопками стадий. TELEGRAM_CHAT_ID (первый) или TELEGRAM_TOPIC_CHAT_ID — группа с темами.
# Узнать ID: добавьте бота в группу и отправьте /id внутри нужной темы.
TELEGRAM_TOPIC_CHAT_ID=
TELEGRAM_TOPIC_NEW=   # тема «🆕 Новые»; пусто — бот создаст её сам (нужно право «Управление темами»)
TELEGRAM_TOPIC_WORK=
TELEGRAM_TOPIC_PICKUP=
TELEGRAM_TOPIC_SHIP=
TELEGRAM_TOPIC_DONE=
# Секрет вебхука (любая случайная строка из латиницы/цифр) — защищает /api/telegram-webhook
TELEGRAM_WEBHOOK_SECRET=
# Кому можно нажимать кнопки (user id через запятую). Пусто — всем участникам группы.
TELEGRAM_ALLOWED_USER_IDS=

# Cloudinary (обязательно для загрузки фото в заказ)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Meta Pixel (Facebook) — ID из Events Manager → Источники данных → Настройки
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (серверные события) — Events Manager → Настройки → Generate access token
META_CAPI_TOKEN=
# Необязательно: код тестовых событий (Events Manager → Тестовые события), убрать после проверки
META_TEST_EVENT_CODE=

# CRM (Telegram Mini App /crm) — заказы в Supabase
SUPABASE_URL=https://uvuavmzrxtyvsytzjywk.supabase.co
# Секретный ключ (Supabase → Project Settings → API Keys → service_role / secret). Только на сервере, в чат не присылать.
SUPABASE_SERVICE_ROLE_KEY=
# Кто может открыть CRM: Telegram user id через запятую (узнать — команда /id в личке бота). Пусто — никто.
CRM_ALLOWED_USER_IDS=
# Имя бота без @ — для ссылки t.me/<бот>/crm?startapp=<код>
TELEGRAM_BOT_USERNAME=
# Только для локальной разработки (вне Telegram): id пользователя из CRM_ALLOWED_USER_IDS. В production не работает.
CRM_DEV_USER_ID=
